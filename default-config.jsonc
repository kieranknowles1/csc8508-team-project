// Default configuration file
// Should not normally be modified, instead create a `user-config.jsonc`
// Use this as a reference for what options are available
{
    "windowWidth": 1280,
    "windowHeight": 720,
    // One of "None", "Exclusive", "Borderless"
    // If borderless, then windowWidth and height should match your display
    // resolution
    "fullscreen": "None",

    // The default host to use when joining a game
    "defaultHost": "10.70.33.113",

    // The number of threads to allocate to loading resources
    "resourceLoaderThreads": 12,

    // Immediately start the game, without showing the main menu
    "quickStart": false
}
