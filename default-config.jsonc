// Default configuration file
// Should not normally be modified, instead create a `user-config.jsonc`
// Use this as a reference for what options are available
{
    "windowWidth": 1920,
    "windowHeight": 1200,
    // One of "None", "Exclusive", "Borderless"
    // If borderless, then windowWidth and height should match your display
    // resolution
    "fullscreen": "Borderless",

    // The default host to use when joining a game, set this to the ip adress of the computer you are using as host
    "defaultHost": "127.0.0.1",

    // Allocate a number of resource loader threads equal to
    // max(1, ceil(physicalThreads * threadMult))
    "resourceThreadMult": 0.9,

    // Immediately start the game, without showing the main menu
    "quickStart": false
}
