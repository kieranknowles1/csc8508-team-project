// https://learn.microsoft.com/en-us/windows/win32/direct3dhlsl/dx-graphics-hlsl-packing-rules
// Note that HLSL packs structs such that data does not cross any 16-byte boundaries
// The layout of these structs must match between CPP and HLSL, there is a check
// for this in debug builds

struct VingetteSettings {
	float intensity;
	float3 color;
	float pulse;
	bool enabled;
};

struct ShaderConstants
{
	matrix shadowMatrix;
	matrix orthoMatrix;

	matrix viewProjMatrix;
	matrix viewMatrix;
	matrix projMatrix;

	matrix inverseViewProjMatrix;
	matrix inverseViewMatrix;
	matrix inverseProjMatrix;

	float3 lightPosition;
	float  lightRadius;
	float4 lightColour;
	float3 cameraPos;
	uint32_t shadowID;

	VingetteSettings vingetteSettings;
};

#ifndef __cplusplus
ConstantBuffer constants : register(c0)
{
	ShaderConstants Constants;
}
#endif
