struct VingetteSettings {
	float intensity;
	float3 color;
	float pulse;
};

struct ShaderConstants
{
	matrix shadowMatrix;
	matrix orthoMatrix;

	matrix viewProjMatrix;
	matrix viewMatrix;
	matrix projMatrix;

	matrix inverseViewProjMatrix;
	matrix inverseViewMatrix;
	matrix inverseProjMatrix;

	float3 lightPosition;
	float  lightRadius;
	float4 lightColour;
	float3 cameraPos;
	uint32_t shadowID;

	VingetteSettings vingetteSettings;
};

#ifndef __cplusplus
ConstantBuffer constants : register(c0)
{
	ShaderConstants Constants;
}
#endif
