#include "ShaderConstants.psslh"
#include "glinterop.h"

#include "../include/post/vingette.glsl"
#include "../include/post/deferred.glsl"

Texture2D<float4> texture : register(t0);
SamplerState sampler : register(s0);

Texture2D<float4> lightDiffuse : register(t1);
SamplerState lightDifSampler : register(s1);

Texture2D<float4> lightSpec : register(t2);
SamplerState lightSpecSampler : register(s2);

struct VS_OUTPUT
{
    float4 position : S_POSITION;
    float2 uv : TEXCOORD0;
};

[CxxSymbol("Passthrough::ps")]
float4 main(VS_OUTPUT vertex) : S_TARGET_OUTPUT
{
    float4 result = texture.Sample(sampler, vertex.uv);

    float4 lightVal = lightDiffuse.Sample(lightDifSampler, vertex.uv);
    float4 specVal = lightSpec.Sample(lightSpecSampler, vertex.uv);
    result.rgb = doDeferredLight(result.rgb, lightVal.rgb, specVal.rgb);

    if (Constants.vingetteSettings.enabled) {
        result.rgb = applyVingette(
            result.rgb,
            vertex.uv,
            Constants.vingetteSettings.intensity,
            Constants.vingetteSettings.color,
            Constants.vingetteSettings.pulse,
        );
    }

    return result;
}
