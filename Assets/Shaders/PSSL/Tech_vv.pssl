#include "ShaderConstants.psslh"
#include "VertexAttributes.psslh"
#include "types.h"
#include "Bindless.psslh"
#include "Vertex.psslh"

#include "glinterop.h"
#include "../include/vert/texscale.glsl"

RegularBuffer<ObjectState> objects : register(t0);

float4 skinVertex(uint vertId, uint jointsId, float4 localPos) {
	float4 skelPos = float4(0, 0, 0, 0);
	RegularBuffer<matrix> joints = bindlessBuffers[jointsId];

	for (int i = 0; i < 4; i++) {
		int index = JointIndices[vertId][i];
		float weight = JointWeights[vertId][i];
		skelPos += mul(joints[index], localPos) * weight;
	}
	return skelPos;
}

[CxxSymbol("TestShader::gs")]
VS_OUTPUT main(uint vertID : S_VERTEX_ID, uint objID : S_SRT_DATA, uint instanceID : S_INSTANCE_ID)
{
	VS_OUTPUT Output;

	uint id = objID + instanceID;

	ObjectState s = objects[id];

	float4 position = float4(Positions[vertID], 1);
	float3 normal = Normals[vertID];
	float4 tangent = Tangents[vertID];

	if (s.animJointsIndex != NULLTEX) {
		position = skinVertex(vertID, s.animJointsIndex, position);
	}
	position = mul(s.modelMatrix, position);

	float2 rawUv = TextureCoords[vertID];
	Output.UV = scaleUv(
		rawUv, s.texScale, normal, s.texRepeats
	);
	if (s.invertY) {
		Output.UV.y = 1.0f - Output.UV.y;
	}

	Output.Position = TransformWorldToClip(position);
	Output.Colour	= s.colour;
	Output.texID	= s.texIndex;
	Output.normId = s.normalIndex;

	float3x3 normMat = transpose(float3x3(s.normalMatrix));

	Output.normal = normalize(mul(normMat, normalize(normal)));
	Output.tangent = normalize(mul(normMat, normalize(tangent.xyz)));
	Output.binormal = cross(Output.tangent, Output.normal) * tangent.w;

	// HACK: Need a proper way of drawing submeshes
	if (vertID < s.startIndex || vertID >= (s.startIndex + s.numElements)) {
		Output.Colour = float4(0, 0, 0, 0);
	}

	return Output;
}
